package proyecto1;
import proyecto1.Lexer;
import java_cup.runtime.*;


// Código del parser
parser code{:
    Lexer lexer;
    @SuppressWarnings("deprecation")
    public parser(Lexer lexer){
        this.lexer = lexer; 
        this.symbolFactory = new DefaultSymbolFactory();
    }

    public boolean syntaxErrors;
    public void syntax_error(Symbol current_token) {
        System.err.println("Syntax error at line " + (current_token.left + 1) +
            ", column " + (current_token.right + 1) +
            ": unexpected token \"" + current_token.value + "\"");
        syntaxErrors = true; // Marcar que ocurrió un error
    }
    
:}

init with {::};

scan with {: Symbol sym = lexer.next_token();
            //System.out.println("Token procesado: " + sym); // Imprime el token procesado
            return sym;:}

// Terminales
terminal INTEGER, BOOLEAN, CHAR, STRING, FLOAT;
terminal LEFT_BRACE, RIGHT_BRACE, LEFT_BRACKET, RIGHT_BRACKET, ASSIGNMENT, LEFT_PARENTHESIS, RIGHT_PARENTHESIS;
terminal ADD, SUB, MUL, DIV, MOD, TO_THE_POWER;
terminal INCREMENT, DECREMENT;
terminal LESS_THAN, LESS_OR_EQUAL_THAN, GREATER_THAN, GREATER_OR_EQUAL_THAN, EQUAL_TO, NOT_EQUAL_TO;
terminal AND, OR, NOT;
terminal SEMICOLON, COLON, IF, ELSE, WHILE, FOR, SWITCH, CASE, DEFAULT, BREAK, RETURN;
terminal PRINT, INPUT;
terminal MAIN;
terminal ID, INTEGER_VAL, FLOAT_VAL, BOOL_VAL, CHAR_VAL, STRING_VAL;
terminal COMMA;


// No terminales
non terminal program, code_block, main;
non terminal literal, comparator, arithmetic_operator;
non terminal for, for_initialization, while, if, else, switch, single_case, cases, read, print, return;
non terminal statement, expression, arithmetic_expression, relational_expression , logic_expression,unary_operation;
non terminal type;
non terminal declaration, variable_declaration, function_declaration;
non terminal function_call, parameters, arguments;
non terminal array_declaration, array_access, array_values_int, array_values_char;
non terminal block;

precedence left OR;       // Disyunción tiene menor precedencia
precedence left AND;      // Conjunción tiene mayor precedencia que OR
precedence right NOT;     // NOT tiene la mayor precedencia
precedence left EQUAL_TO, NOT_EQUAL_TO;
precedence left LESS_THAN, LESS_OR_EQUAL_THAN, GREATER_THAN, GREATER_OR_EQUAL_THAN;
precedence left ADD, SUB;
precedence left MUL, DIV, MOD;
precedence right TO_THE_POWER;  // Precedencia más alta para potenciación
precedence right INCREMENT, DECREMENT, NOT;  // Precedencia para unarios
precedence right LEFT_PARENTHESIS;

start with program;

type ::= INTEGER:tipo {:RESULT = "entero"; :} // Cargar tipos unicamente
       | BOOLEAN:tipo {:RESULT = "booleano"; :}
       | CHAR:tipo {:RESULT = "char"; :}
       | STRING:tipo {:RESULT = "string"; :}
       | FLOAT:tipo {:RESULT = "flotante"; :};

literal ::= ID
         | INTEGER_VAL 
         | FLOAT_VAL
         | BOOL_VAL 
         | CHAR_VAL 
         | STRING_VAL ;

unary_operation ::= ID INCREMENT
                | ID DECREMENT;

arithmetic_operator ::= ADD 
         | SUB 
         | MUL 
         | DIV 
         | MOD
         | TO_THE_POWER;

comparator ::= LESS_THAN
             | LESS_OR_EQUAL_THAN 
             | GREATER_THAN 
             | GREATER_OR_EQUAL_THAN 
             | EQUAL_TO
             | NOT_EQUAL_TO ;
expression ::= arithmetic_expression | relational_expression | logic_expression;

arithmetic_expression ::= literal 
            | function_call 
            | LEFT_PARENTHESIS arithmetic_expression RIGHT_PARENTHESIS 
            | arithmetic_expression arithmetic_operator arithmetic_expression 
            | unary_operation
            | array_access;
relational_expression ::= arithmetic_expression comparator arithmetic_expression;
logic_expression ::= expression AND expression
                  | expression OR expression
                  | NOT expression;

function_call ::= ID LEFT_PARENTHESIS arguments RIGHT_PARENTHESIS;

statement ::= for {::}//{: System.out.println("Stmt detectado: For"); :}
            | while //{: System.out.println("Stmt detectado: While");:}
            | if //{: System.out.println("Stmt detectado: If"); :}
            | else //{: System.out.println("Stmt detectado: Else"); :}
            | switch //{: System.out.println("Stmt detectado: Switch");:}
            | declaration
            | read //{: System.out.println("Stmt detectado: Read"); :}
            | print //{: System.out.println("Stmt detectado: Print"); :}
            | return //{: System.out.println("Stmt detectado: Return"); :}
            | function_call SEMICOLON //{: System.out.println("Stmt detectado: Function Call"); :}
            | NOT expression SEMICOLON //{: System.out.println("Stmt detectado: NOT"); :}
            | unary_operation SEMICOLON //{: System.out.println("Stmt detectado: Operacion unaria"); :}
            | array_declaration 
            | array_access SEMICOLON;
            | error SEMICOLON;

block ::= LEFT_BRACE {:TablaSimbolos.abrirScope();:} code_block RIGHT_BRACE {:TablaSimbolos.cerrarScope();:};
code_block ::= statement
             | expression
             | statement code_block
             | expression code_block;

declaration ::= variable_declaration:type //{: System.out.println("Declaracion detectada: Variable: "+ type.toString());  :} 
              | function_declaration:type ;//{: System.out.println("--Declaracion detectada: Función"); :}; 

//Crear entrada de variable
variable_declaration ::= type:typeVar ID:idVar SEMICOLON {:RESULT=typeVar;:}
                        | type:typeVar ID:idVar ASSIGNMENT expression SEMICOLON {:RESULT=typeVar;
                          Simbolo simbolo = new Simbolo(idVar.toString(),typeVar.toString(),idVarleft,idVarright);
                          TablaSimbolos.agregarSimbolo(simbolo);:};

//Crear entrada de función
function_declaration ::= type:typeVar ID:idVar LEFT_PARENTHESIS parameters RIGHT_PARENTHESIS LEFT_BRACE 
                        {:
                            Simbolo simbolo = new Simbolo(idVar.toString(),typeVar.toString(),idVarleft,idVarright);
                            simbolo.setFunction(typeVar.toString(), TablaSimbolos.getParametrosEnEspera());
                            TablaSimbolos.limpiarParametrosEnEspera();
                            TablaSimbolos.agregarSimbolo(simbolo);
                            
                            //TablaSimbolos.abrirScope();
                        :} 
                        code_block RIGHT_BRACE {: //TablaSimbolos.cerrarScope();:};

parameters ::= type:typeVar ID:idVar {:
                Simbolo simbolo = new Simbolo(idVar.toString(),typeVar.toString(),idVarleft,idVarright);
                TablaSimbolos.agregarParametroEnEspera(simbolo);
            :}//Entrada de parametros
             | type:typeVar ID:idVar COMMA parameters{:
                Simbolo simbolo = new Simbolo(idVar.toString(),typeVar.toString(),idVarleft,idVarright);
                TablaSimbolos.agregarParametroEnEspera(simbolo);
            :};

arguments ::= expression 
            | expression COMMA arguments ;

return ::= RETURN expression SEMICOLON 
         | RETURN SEMICOLON;

read ::= INPUT LEFT_PARENTHESIS expression RIGHT_PARENTHESIS SEMICOLON;

print ::= PRINT LEFT_PARENTHESIS expression RIGHT_PARENTHESIS SEMICOLON;

if ::= IF LEFT_PARENTHESIS expression RIGHT_PARENTHESIS block
    | IF LEFT_PARENTHESIS expression RIGHT_PARENTHESIS block ELSE block; 

for_initialization ::= type:typeVar ID:idVar 
                     | type:typeVar ID:idVar ASSIGNMENT INTEGER_VAL;

for ::= FOR LEFT_PARENTHESIS for_initialization SEMICOLON expression SEMICOLON unary_operation RIGHT_PARENTHESIS block;

while ::= WHILE LEFT_PARENTHESIS expression RIGHT_PARENTHESIS block;

single_case ::= CASE expression COLON code_block BREAK SEMICOLON;

cases ::= single_case cases 
        | single_case;

switch ::= SWITCH LEFT_PARENTHESIS expression RIGHT_PARENTHESIS 
           LEFT_BRACE {: TablaSimbolos.abrirScope(); :} 
           cases DEFAULT COLON code_block BREAK SEMICOLON RIGHT_BRACE 
           {: TablaSimbolos.cerrarScope(); :};

main ::= MAIN LEFT_PARENTHESIS RIGHT_PARENTHESIS block;

array_declaration ::= INTEGER LEFT_BRACKET RIGHT_BRACKET ID ASSIGNMENT LEFT_BRACE array_values_int RIGHT_BRACE SEMICOLON //{: System.out.println("Declaracion detectada: Array Int"); :}
                    | CHAR LEFT_BRACKET RIGHT_BRACKET ID ASSIGNMENT LEFT_BRACE array_values_char RIGHT_BRACE SEMICOLON ;//{: System.out.println("Declaracion detectada: Array Char"); :};

array_values_int ::=  INTEGER_VAL | INTEGER_VAL COMMA array_values_int;
array_values_char ::= CHAR_VAL | CHAR_VAL COMMA array_values_char;

array_access ::= ID LEFT_BRACKET INTEGER_VAL RIGHT_BRACKET ;//{: System.out.println("Se acceso a un array"); :};

program ::= function_declaration program 
         | main;