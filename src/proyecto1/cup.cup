package proyecto1;
import proyecto1.Lexer;
import java_cup.runtime.*;
import java.util.*;

/*
 * Parser CUP para análisis sintáctico y generación de código intermedio (TAC).
 * 
 * Este parser utiliza un lexer para el análisis léxico y maneja errores 
 * sintácticos y semánticos. Incluye la generación de etiquetas y temporales 
 * para la construcción de código de tres direcciones (Three-Address Code - TAC).
 * 
 * Funcionalidades principales:
 * - Manejo de errores sintácticos con mensajes detallados (línea y columna).
 * - Evaluación de comparadores y operadores aritméticos.
 * - Gestión de expresiones switch con soporte para etiquetas de inicio y fin.
 * - Seguimiento de errores semánticos para depuración.
 */
parser code{:
    Lexer lexer;
    @SuppressWarnings("deprecation")
    public parser(Lexer lexer){
        this.lexer = lexer; 
        this.symbolFactory = new DefaultSymbolFactory();
    }

    public boolean syntaxErrors;
    public void syntax_error(Symbol current_token) {
        System.err.println("Syntax error at line " + (current_token.left + 1) +
            ", column " + (current_token.right + 1) +
            ": unexpected token \"" + current_token.value + "\"");
        syntaxErrors = true; // Marcar que ocurrió un error
    }

    String tac = "";
    int tempCount = 0;
    int labelCount = 0;
    boolean commentTac = false;
    boolean semanticErrors = false;

    String currentSwitchExpression = "";
    String currentSwitchLabel = "";

    private String getCurrentSwitchExpression() {
        return currentSwitchExpression;
    }
    private void setCurrentSwitchExpression(String expression) {
        currentSwitchExpression = expression;
    }
    private String getCurrentSwitchLabel() {
        return currentSwitchLabel;
    }
    private void setCurrentSwitchLabel(String label) {
        currentSwitchLabel = label;
    }
    private void cleanCurrentSwitchExpression() {
        currentSwitchExpression = "";
    }
    private void cleancurrentSwitchLabel() {
        currentSwitchLabel = "";
    }

    Stack<String> stackStartLabels = new Stack<String>();
    Stack<String> stackEndLabels = new Stack<String>();

    private String newLabel() {
        return "L" + (labelCount++);
    }
    private String newTemp() {
        return "t" + (tempCount++);
    }

    private void emit(String text) {
        tac += text + "\n";
    }
    private String evaluateComparator(String e1, String comparator, String e2) {
        try {
            if (e1 == null || e2 == null) 
                emit("!!!!! ERROR !!!!! - Cannot compare null values");
            String temp = newTemp();
            switch (comparator) {
                case "==":
                    emit(temp + "=" + e1 + "==" + e2);
                    return temp;
                case "!=":
                    emit(temp + "=" + e1 + "!=" + e2);
                    return temp;
                case "<":
                    emit(temp + "=" + e1 + "<" + e2);
                    return temp;
                case ">":
                    emit(temp + "=" + e1 + ">" + e2);
                    return temp;
                case "<=":
                    emit(temp + "=" + e1 + "<=" + e2);
                    return temp;
                case ">=":
                    emit(temp + "=" + e1 + ">=" + e2);
                    return temp;
                default:
                    emit("!!!!! ERROR !!!!! - Unknown comparator: " + comparator);
            }
        } catch (Exception ex) {
            emit("!!!!! ERROR !!!!! - Error evaluating comparator: " + ex.getMessage());
        }
        return null;
    }
    private String evaluateArithmetic(String e1, String operator, String e2) {
        try {
            if (e1 == null || e2 == null) 
                emit("!!!!! ERROR !!!!! - Cannot perform arithmetic operations with null values");
            if (e1.matches("[a-zA-Z]+")) {
                String temp = newTemp();
                emit(temp + "=" + e1);
                e1 = temp;
            }
            if (e2.matches("[a-zA-Z]+")) {
                String temp = newTemp();
                emit(temp + "=" + e2);
                e2 = temp;
            }
            String temp = newTemp();
            switch (operator) {
                case "+":
                    emit(temp + "=" + e1 + "+" + e2);
                    return temp;
                case "-":
                    emit(temp + "=" + e1 + "-" + e2);
                    return temp;
                case "*":
                    emit(temp + "=" + e1 + "*" + e2);
                    return temp;
                case "/":
                    emit(temp + "=" + e1 + "/" + e2);
                    return temp;
                case "%":
                    emit(temp + "=" + e1 + "%" + e2);
                    return temp;
                case "^":
                    emit(temp + "=" + e1 + "^" + e2);
                    return temp;
                default:
                    emit("!!!!! ERROR !!!!! - Unknown arithmetic operator: " + operator);
            }
        } catch (Exception ex) {
            emit("!!!!! ERROR !!!!! - Error evaluating arithmetic: " + ex.getMessage());
        }
        return null;
    }
    private String getType(String expression) {
        try {
            return expression.split(":")[0];
        } catch (Exception ex) {
            emit("!!!!! ERROR !!!!! - Error getting type: " + ex.getMessage());
        }
        return null;
    }
    private String getValue(String expression) {
        try {
            return expression.toString().split(":")[1];
        } catch (Exception ex) {
            emit("!!!!! ERROR !!!!! - Error getting value " + expression +" : " + ex.getMessage());
        }
        return null;
    }
:}


init with {::};

scan with {: Symbol sym = lexer.next_token();
            return sym;:}

/*
 * Definición de terminales, no terminales y reglas de precedencia para el parser CUP.
 * 
 * Terminales:
 * - Incluyen tipos de datos primitivos (INTEGER, BOOLEAN, FLOAT, etc.), operadores aritméticos, 
 *   lógicos, de comparación y símbolos de control de flujo (IF, ELSE, FOR, SWITCH, etc.).
 * 
 * No terminales:
 * - Representan estructuras gramaticales como declaraciones de variables, funciones, 
 *   estructuras de control, operaciones aritméticas y lógicas, entre otros.
 * 
 * Precedencia de operadores:
 * - Define la prioridad y la asociatividad de los operadores para resolver ambigüedades en expresiones.
 * - Se establece de izquierda a derecha para la mayoría de los operadores y de derecha a izquierda 
 *   para operadores unarios, incrementos y exponentiación.
 */

terminal INTEGER, BOOLEAN, CHAR, STRING, FLOAT;
terminal LEFT_BRACE, RIGHT_BRACE, LEFT_BRACKET, RIGHT_BRACKET, ASSIGNMENT, LEFT_PARENTHESIS, RIGHT_PARENTHESIS;
terminal ADD, SUB, MUL, DIV, MOD, TO_THE_POWER;
terminal INCREMENT, DECREMENT;
terminal LESS_THAN, LESS_OR_EQUAL_THAN, GREATER_THAN, GREATER_OR_EQUAL_THAN, EQUAL_TO, NOT_EQUAL_TO;
terminal AND, OR, NOT;
terminal SEMICOLON, COLON, IF, ELSE, WHILE, FOR, SWITCH, CASE, DEFAULT, BREAK, RETURN;
terminal PRINT, INPUT;
terminal MAIN;
terminal ID, INTEGER_VAL, FLOAT_VAL, BOOL_VAL, CHAR_VAL, STRING_VAL;
terminal COMMA;


non terminal program, code_block, main;
non terminal comparator, arithmetic_operator;
non terminal for, for_initialization, while, if, switch, single_case, cases, read, print, return;
non terminal statement, expression, unary_operation;
non terminal type;
non terminal declaration, variable_declaration, function_declaration;
non terminal function_call, parameters, arguments;
non terminal array_declaration, array_access, array_values;
non terminal block;
non terminal literal, value_assignment, array_position_assignment, array_declaration_aux;
non terminal case1, switch_aux, program_aux;

precedence left OR;       
precedence left AND;      
precedence right NOT;     
precedence left EQUAL_TO, NOT_EQUAL_TO;
precedence left LESS_THAN, LESS_OR_EQUAL_THAN, GREATER_THAN, GREATER_OR_EQUAL_THAN;
precedence left ADD, SUB;
precedence left MUL, DIV, MOD;
precedence right TO_THE_POWER; 
precedence right INCREMENT, DECREMENT, NOT; 
precedence right LEFT_PARENTHESIS;

start with program;
type ::= INTEGER:tipo {:RESULT = "int"; :} // Cargar tipos unicamente
    | BOOLEAN:tipo {:RESULT = "bool"; :}
    | CHAR:tipo {:RESULT = "char"; :}
    | STRING:tipo {:RESULT = "string"; :}
    | FLOAT:tipo {:RESULT = "float"; :};

/*
 * Producción: unary_operation
 * 
 * Esta regla define las operaciones unarias de incremento (++) y decremento (--) aplicadas a identificadores (ID).
 * 
 * Validaciones semánticas:
 * 1. Verificación de existencia: Se consulta la tabla de símbolos para comprobar si el ID está declarado.
 * 2. Verificación de valor: Se asegura que el ID tenga un valor asignado antes de realizar la operación unaria.
 * 3. Verificación de tipo: La operación solo se permite para variables de tipo entero ("int").
 * 
 * Manejo de errores:
 * - Si alguna validación falla, se emite un mensaje de error detallado indicando el tipo de error y la línea correspondiente.
 * - Se utiliza `semanticErrors = true` para marcar la existencia de errores semánticos en la operación.
 * 
 * Generación de código intermedio (Three-Address Code - TAC):
 * - Si las validaciones son exitosas, se genera una instrucción en formato `int:ID:ID:OP`, donde `OP` es `+` para incremento o `-` para decremento.
 */

unary_operation ::= ID:id INCREMENT 
              {: 
               try {
                Simbolo simbolo = TablaSimbolos.buscar(id.toString());
                if (simbolo == null) {
                    emit("!!!!! ERROR !!!!! - ID " + id.toString() + " not found. Line: " + idleft);
                    semanticErrors = true;
                }
                if (simbolo.getValue() == null) {
                    emit("!!!!! ERROR !!!!! - ID " + id.toString() + " is empty. Value needed for unary operation. Line: " + idleft);
                    semanticErrors = true;
                }
                if (!(simbolo.type.equals("int"))) {
                    emit("!!!!! ERROR !!!!! - ID " + id.toString() + " is not an integer. Unary operation only allowed for integers. Line: " + idleft);
                    semanticErrors = true;
                }
                RESULT = "int:"+id.toString()+":"+id.toString()+":+";
               } catch (Exception e) {
                emit("!!!!! ERROR !!!!! - Error in unary operation: " + e.getMessage() + ". Line: " + idleft);
                semanticErrors = true;
               }
              :}
            | ID:id DECREMENT 
              {: 
               try {
                Simbolo simbolo = TablaSimbolos.buscar(id.toString());
                if (simbolo == null) {
                    emit("!!!!! ERROR !!!!! - ID " + id.toString() + " not found. Line: " + idleft);
                    semanticErrors = true;
                }
                if (simbolo.getValue() == null) {
                    emit("!!!!! ERROR !!!!! - ID " + id.toString() + " is empty. Value needed for unary operation. Line: " + idleft);
                    semanticErrors = true;
                }
                try {
                    Integer.parseInt(simbolo.getValue());
                } catch (Exception e) {
                    emit("!!!!! ERROR !!!!! - ID " + id.toString() + " is not an integer. Unary operation only allowed for integers. Line: " + idleft);
                    semanticErrors = true;
                }
                RESULT = "int:"+id.toString()+":"+id.toString()+":-";
               } catch (Exception e) {
                emit("!!!!! ERROR !!!!! - Error in unary operation: " + e.getMessage() + ". Line: " + idleft);
                semanticErrors = true;
               }
              :};

/*
 * Producción: arithmetic_operator
 * 
 * Esta regla define los operadores aritméticos básicos que se utilizan para construir expresiones matemáticas.
 * 
 * Operadores soportados:
 * - Suma (+)
 * - Resta (-)
 * - Multiplicación (*)
 * - División (/)
 * - Módulo (%)
 * - Potencia (^)
 * 
 * Generación de código:
 * - Cada operador se asigna directamente a un símbolo correspondiente en `RESULT` para su posterior uso en la generación de código intermedio (TAC).
 */
arithmetic_operator ::= ADD {:RESULT = "+"; :}
    | SUB {:RESULT = "-"; :}
    | MUL {:RESULT = "*"; :}
    | DIV {:RESULT = "/"; :}
    | MOD {:RESULT = "%"; :}
    | TO_THE_POWER {:RESULT = "^"; :};


/*
 * Producción: comparator
 * 
 * Esta regla define los operadores de comparación utilizados en expresiones condicionales.
 * 
 * Comparadores soportados:
 * - Menor que (<)
 * - Menor o igual que (<=)
 * - Mayor que (>)
 * - Mayor o igual que (>=)
 * - Igual a (==)
 * - Distinto de (!=)
 * 
 * Generación de código:
 * - Cada comparador se asigna directamente a su representación en `RESULT`, facilitando su integración en evaluaciones de condiciones lógicas en el código intermedio (TAC).
 */

comparator ::= LESS_THAN {:RESULT = "<"; :}
          | LESS_OR_EQUAL_THAN {:RESULT = "<="; :}
          | GREATER_THAN {:RESULT = ">"; :}
          | GREATER_OR_EQUAL_THAN {:RESULT = ">="; :}
          | EQUAL_TO {:RESULT = "=="; :}
          | NOT_EQUAL_TO {:RESULT = "!="; :}; 

/*
 * Producción: literal
 * 
 * Esta regla gestiona la interpretación de literales en el código fuente, incluyendo variables, números, booleanos, caracteres y cadenas de texto.
 * 
 * Casos manejados:
 * 1. **Identificadores (ID)**:
 *    - Se consulta la tabla de símbolos (`TablaSimbolos`) para verificar si la variable está declarada.
 *    - Si no existe, se emite un error semántico.
 *    - Si existe, se obtiene su tipo y nombre para generar la representación en `RESULT`.
 * 
 * 2. **Valores literales**:
 *    - **Enteros (INTEGER_VAL)**, **flotantes (FLOAT_VAL)**, **booleanos (BOOL_VAL)**, **caracteres (CHAR_VAL)** y **cadenas de texto (STRING_VAL)**:
 *    - Cada tipo se procesa para generar su representación con el formato `tipo:valor` (por ejemplo, `int:5` o `string:"hola"`).
 *    - Se manejan errores de procesamiento mediante `try-catch` para garantizar la robustez del análisis semántico.
 * 
 * Manejo de errores:
 * - Se emiten mensajes detallados en caso de errores, indicando el tipo de problema y la línea donde ocurrió.
 * - `semanticErrors = true` se activa si ocurre un error durante el análisis.
 */

literal ::= ID:id {:
         try {
          Simbolo simbolo = TablaSimbolos.buscar(id.toString());
          if (simbolo == null) {
              emit("!!!!! ERROR !!!!! - ID " + id.toString() + " not found. Line: " + idleft);
              semanticErrors = true;
          }
          RESULT = simbolo.type.toString() + ":" + id.toString();
         } catch (Exception e) {
          emit("!!!!! ERROR !!!!! - Error in literal: " + e.getMessage() + ". Line: " + idleft);
          semanticErrors = true;
         }
         :}
         | INTEGER_VAL:i {:
            try {
                RESULT = "int:" + i.toString();
            } catch (Exception ex) {
                emit("!!!!! ERROR !!!!! - Error processing integer value: " + ex.getMessage() + ". Line: " + ileft);
                semanticErrors = true;
            }
         :}
         | FLOAT_VAL:f {:
            try {
                RESULT = "float:" + f.toString();
            } catch (Exception ex) {
                emit("!!!!! ERROR !!!!! - Error processing float value: " + ex.getMessage() + ". Line: " + fleft);
                semanticErrors = true;
            }
         :}
         | BOOL_VAL:b {:
            try {
                RESULT = "bool:" + b.toString();
            } catch (Exception ex) {
                emit("!!!!! ERROR !!!!! - Error processing boolean value: " + ex.getMessage() + ". Line: " + bleft);
                semanticErrors = true;
            }
         :}
         | CHAR_VAL:c {:
            try {
                RESULT = "char:" + c.toString();
            } catch (Exception ex) {
                emit("!!!!! ERROR !!!!! - Error processing char value: " + ex.getMessage() + ". Line: " + cleft);
                semanticErrors = true;
            }
         :}
         | STRING_VAL:s {:
            try {
                RESULT = "string:" + s.toString();
            } catch (Exception ex) {
                emit("!!!!! ERROR !!!!! - Error processing string value: " + ex.getMessage() + ". Line: " + sleft);
                semanticErrors = true;
            }
         :};

// Producción: expression
//
// La regla `expression` define una expresión matemática o lógica en el lenguaje, la cual puede ser un literal,
// una expresión entre paréntesis, una operación aritmética entre dos expresiones, una operación unaria,
// una llamada a función, una comparación, una operación lógica AND, OR o NOT, o un acceso a un arreglo.
//
// En cada caso, se evalúa el tipo de los operandos y se realiza la operación correspondiente,
// validando que los tipos sean compatibles y generando el código intermedio necesario.
//
// Generación de código:
// - Para las operaciones aritméticas y lógicas se generan instrucciones en código intermedio (TAC),
//   como comparaciones, operaciones y asignaciones de valores temporales.
//

expression ::= literal:i {:
    try {
        RESULT = i.toString();
    } catch (Exception e) {
        emit("!!!!! ERROR !!!!! - Error in expression: " + e.getMessage() + ". Line: " + ileft);
        semanticErrors = true;
    }
    :}
    | LEFT_PARENTHESIS expression:e RIGHT_PARENTHESIS {:
        try {
            RESULT = e.toString();
        } catch (Exception ex) {
            emit("!!!!! ERROR !!!!! - Error in expression: " + ex.getMessage() + ". Line: " + eleft);
            semanticErrors = true;
        }
    :}
         | expression:e1 arithmetic_operator:o expression:e2 {:
         try {
          if (commentTac) emit("// Performing " + e1.toString() + " " + o.toString() + " " + e2.toString());
          String e1Type = getType(e1.toString());
          String e2Type = getType(e2.toString());
          if (e1Type.equals("int") && e2Type.equals("int")) 
              RESULT = "int:"+evaluateArithmetic(getValue(e1.toString()), o.toString(), getValue(e2.toString()));
          else if (e1Type.equals("float") && e2Type.equals("float"))
              RESULT = "float:"+evaluateArithmetic(getValue(e1.toString()), o.toString(), getValue(e2.toString())); 
          else {
              emit("!!!!! ERROR !!!!! - Incompatible types for arithmetic operations, only integer-integer and float-float are allowed. Line: " + e1left);
              emit("e1: " + e1.toString() + " e2: " + e2.toString());
              emit("------------------------------");
              semanticErrors = true;
          }
         } catch (Exception ex) {
          emit("!!!!! ERROR !!!!! - Error in arithmetic expression: " + ex.getMessage() + ". Line: " + e1left);
          semanticErrors = true;
         }
         :}
         | unary_operation:o {:
          try {
              String[] parts = o.toString().split(":");
              String id = parts[1];
              String operation = parts[3];
              if (operation.equals("+")) {
               if (commentTac) emit("Incrementing " + id + " by 1");
               String temp1 = newTemp();
               emit(temp1 + "=1");
               String temp2 = newTemp();
               emit(temp2 + "=" + id + "+" + temp1);
               emit(id + "=" + temp2);
              } else {
               if (commentTac) emit("Decrementing " + id + " by 1");
               String temp1 = newTemp();
               emit(temp1 + "=1");
               String temp2 = newTemp();
               emit(temp2 + "=" + id + "-" + temp1);
               emit(id + "=" + temp2);
              }
              RESULT = o.toString();
          } catch (Exception ex) {
              emit("!!!!! ERROR !!!!! - Error in unary operation: " + ex.getMessage() + ". Line: " + oleft);
              semanticErrors = true;
          }
         :}
         | function_call:f {:
            try {
                RESULT = f.toString();
            } catch (Exception ex) {
                emit("!!!!! ERROR !!!!! - Error in function call: " + ex.getMessage() + ". Line: " + fleft);
                semanticErrors = true;
            }
         :}
         | expression:e1 comparator:c expression:e2 {: 
          try {
              if (commentTac) emit("// Comparing " + e1.toString() + " " + c.toString() + " " + e2.toString());
              String e1Type = getType(e1.toString());
              String e2Type = getType(e2.toString());
              if ((e1Type.equals("int") && e2Type.equals("int") || (e1Type.equals("float") && e2Type.equals("float")))) 

               RESULT = "bool:"+evaluateComparator(getValue(e1.toString()), c.toString(), getValue(e2.toString())); 
              else {
               emit("!!!!! ERROR !!!!! - Incompatible types for comparison operations, only integer-integer and float-float are allowed. Line: " + e1left);
               emit("e1: " + e1 + " e2: " + e2);
               emit("------------------------------");
               semanticErrors = true;
              }
          } catch (Exception ex) {
              emit("!!!!! ERROR !!!!! - Error in comparison expression: " + ex.getMessage() + ". Line: " + e1left);
              semanticErrors = true;
          }
         :}
         | expression:e1 AND expression:e2 {:
          try {
              if (commentTac) emit("// Performing " + e1.toString() + " AND " + e2.toString());
              String e1Type = getType(e1.toString());
              String e2Type = getType(e2.toString());
              if (e1Type.equals("bool") && e2Type.equals("bool")) {
               String temp = newTemp();
               emit(temp + "=" + getValue(e1.toString()) + "&&" + getValue(e2.toString()));
               RESULT = "bool:" + temp;
              } else {
               emit("!!!!! ERROR !!!!! - Incompatible types for AND operation, only boolean-boolean is allowed. Line: " + e1left);
               semanticErrors = true;
              }
          } catch (Exception ex) {
              emit("!!!!! ERROR !!!!! - Error in AND expression: " + ex.getMessage() + ". Line: " + e1left);
              semanticErrors = true;
          }
         :}
         | expression:e1 OR expression:e2 {:
          try {
              if (commentTac) emit("// Performing " + e1.toString() + " OR " + e2.toString());
              String e1Type = getType(e1.toString());
              String e2Type = getType(e2.toString());
              if (e1Type.equals("bool") && e2Type.equals("bool")) {
               String temp = newTemp();
               emit(temp + "=" + getValue(e1.toString()) + "||" + getValue(e2.toString()));
               RESULT = "bool:" + temp;
              } else {
               emit("!!!!! ERROR !!!!! - Incompatible types for OR operation, only boolean-boolean is allowed. Line: " + e1left);
               semanticErrors = true;
              }
          } catch (Exception ex) {
              emit("!!!!! ERROR !!!!! - Error in OR expression: " + ex.getMessage() + ". Line: " + e1left);
              semanticErrors = true;
          }
         :}
         | NOT expression:e {:
          try {
              if (commentTac) emit("// Performing NOT " + e.toString());
              String eType = getType(e.toString());
              if (eType.equals("bool")) {
               String temp = newTemp(); 
               emit(temp + "=!" + getValue(e.toString()));
               RESULT = "bool:" + temp;
              } else {
               emit("!!!!! ERROR !!!!! - Incompatible type for NOT operation, only boolean is allowed. Line: " + eleft);
               semanticErrors = true;
              }
          } catch (Exception ex) {
              emit("!!!!! ERROR !!!!! - Error in NOT expression: " + ex.getMessage() + ". Line: " + eleft);
              semanticErrors = true;
          }
         :}
         | array_access:a {:
          try {
              RESULT = a.toString();
          } catch (Exception ex) {
              emit("!!!!! ERROR !!!!! - Error in array access: " + ex.getMessage() + ". Line: " + aleft);
              semanticErrors = true;
          }
         :};

// Producción: statement
//
// La regla `statement` define una declaración o sentencia en el lenguaje, como:
// - Sentencias de control como `for`, `while`, `if`, `switch`.
// - Declaraciones de variables o funciones.
// - Operaciones de lectura o escritura (read/print).
// - Sentencias de retorno o invocación de funciones.
// - Asignaciones de valores o de elementos de un arreglo.
//
// Se genera código intermedio correspondiente para cada tipo de sentencia, manejando las estructuras de control
// y las modificaciones de valores, así como la asignación de variables temporales en el caso de las operaciones unarias.
//
// Generación de código:
// - Se crean instrucciones de control de flujo como `goto`, `if` y ciclos (`while`, `for`).
// - Las declaraciones de variables se gestionan con instrucciones de asignación de memoria y valores iniciales.
//
statement ::= for // Ya
            | while // Ya
            | if // Ya
            | switch // Ya
            | declaration // Ya
            | read // Ya
            | print // Ya 
            | return // Ya
            | function_call SEMICOLON // Ya
            | unary_operation:o {: // Ya
                try {
                    String[] parts = o.toString().split(":");
                    String id = parts[1];
                    String operation = parts[3];
                    if (operation.equals("+")) {
                        if (commentTac) emit("// Incrementing " + id + " by 1");
                        String temp1 = newTemp();
                        emit(temp1 + "=1");
                        String temp2 = newTemp();
                        emit(temp2 + "=" + id + "+" + temp1);
                        emit(id + "=" + temp2);
                    } else {
                        if (commentTac) emit("// Decrementing " + id + " by 1");
                        String temp1 = newTemp();
                        emit(temp1 + "=1");
                        String temp2 = newTemp();
                        emit(temp2 + "=" + id + "-" + temp1);
                        emit(id + "=" + temp2);
                    }
                    RESULT = o.toString();
                } catch (Exception ex) {
                    emit("!!!!! ERROR !!!!! - Error in unary operation: " + ex.getMessage() + ". Line: " + oleft);
                    semanticErrors = true;
                }
            :} SEMICOLON // Ya
            | array_declaration // Ya
            | array_access SEMICOLON // Ya
            | value_assignment // Ya
            | array_position_assignment SEMICOLON // Ya
            | block
            | error SEMICOLON;

// Producción: block
//
// La regla `block` define un bloque de código delimitado por llaves `{}`. 
// Dentro de este bloque se ejecutan varias sentencias y expresiones.
// Al abrir un bloque de código, se crea un nuevo ámbito para las variables y funciones.
// Al cerrarlo, se elimina ese ámbito de la tabla de símbolos.
//
// Generación de código:
// - Se generan instrucciones para manejar el alcance de las variables mediante operaciones de apertura y cierre de ámbitos.
// - Dentro del bloque se procesan sentencias y expresiones generando el código correspondiente.
//
block ::= LEFT_BRACE {:TablaSimbolos.abrirScope();:} code_block RIGHT_BRACE {:TablaSimbolos.cerrarScope();:}
                |error RIGHT_BRACE ;

// Producción: code_block
//
// La regla `code_block` define un bloque de código que puede contener sentencias y expresiones.
// Un `code_block` puede ser una secuencia de sentencias, una secuencia de expresiones, o una combinación de ambas.
//
// Generación de código:
// - Las sentencias dentro de un `code_block` se traducen en código intermedio correspondiente.
// - Se procesan expresiones y sentencias en el orden en que aparecen en el bloque.
//
code_block ::= statement
                | expression
                | statement code_block
                | expression code_block;

// Producción: declaration
//
// La regla `declaration` define una declaración en el lenguaje, que puede ser una declaración de variable o de función.
// Una variable se declara con un tipo y una posible inicialización de valor, mientras que una función se declara con su tipo de retorno y parámetros.
//
// Generación de código:
// - Para las declaraciones de variables se reserva espacio en memoria y se inicializan si es necesario.
// - Las funciones se registran en la tabla de símbolos y se genera código para su cuerpo de acuerdo con su definición.
//
declaration ::= variable_declaration:type 
                | function_declaration:type ;


// Asignación de valor a una variable
//
// La regla `value_assignment` representa la asignación de un valor a una variable previamente declarada.
// El identificador (`ID`) se busca en la tabla de símbolos y se verifica que exista, y que el tipo de la variable sea compatible con el valor a asignar. 
// Si el tipo no coincide, se genera un error semántico. 
// Además, se actualiza el valor de la variable en la tabla de símbolos.
//
// Generación de código:
// - Se verifica si el identificador ya ha sido declarado.
// - Se asegura que el tipo de la variable sea compatible con el valor asignado.
// - El valor se asigna a la variable en la tabla de símbolos y se emite el código correspondiente.
value_assignment ::= ID:id ASSIGNMENT expression:e SEMICOLON {:
                        try {
                            Simbolo simbolo = TablaSimbolos.buscar(id.toString());
                            if (simbolo == null) {
                                emit("!!!!! ERROR !!!!! - ID " + id.toString() + " not found. Line: " + idleft);
                                semanticErrors = true;
                            }
                            if (!simbolo.type.equals(getType(e.toString()))) {
                                emit("!!!!! ERROR !!!!! - ID " + id.toString() + " is not of type " + getType(e.toString()) + ". Value assigned has to be of the same type. Line: " + idleft);
                                semanticErrors = true;
                            }
                            simbolo.setValue(getValue(e.toString()));
                            emit(id.toString() + "=" + getValue(e.toString()));
                        } catch (Exception ex) {
                            emit("!!!!! ERROR !!!!! - Error in value assignment: " + ex.getMessage() + ". Line: " + idleft);
                            semanticErrors = true;
                        }
                    :};


// Declaración de variable
//
// La regla `variable_declaration` define la declaración de una variable con o sin inicialización.
// Se verifica si la variable ya ha sido declarada antes en la tabla de símbolos. Si no es así, se agrega una nueva entrada.
// Si la variable tiene un valor de inicialización, este valor se asigna correctamente al declarar la variable.
//
// Generación de código:
// - Se reserva espacio en memoria para la variable declarada.
// - Si es necesario, se asigna el valor inicial de la variable y se emite el código correspondiente.
// - Se añade la variable a la tabla de símbolos.
variable_declaration ::= type:typeVar ID:idVar SEMICOLON {:
                        try {
                            if (commentTac) emit("// Variable " + idVar.toString() + " declaration");
                            Simbolo simbolo = new Simbolo(idVar.toString(),typeVar.toString(),idVarleft,idVarright);
                            TablaSimbolos.agregarSimbolo(simbolo);
                            emit(typeVar.toString() + ":" +idVar.toString());
                            RESULT=""+typeVar.toString()+":"+idVar.toString();
                        } catch (Exception ex) {
                            emit("!!!!! ERROR !!!!! - Error in variable declaration: " + ex.getMessage() + ". Line: " + idVarleft);
                            semanticErrors = true;
                        }
                    :}
                    | type:typeVar ID:idVar ASSIGNMENT expression:e SEMICOLON {:
                        try {
                            if (commentTac) emit("// Variable " + idVar.toString() + " declaration with value");
                            Simbolo simbolo = new Simbolo(idVar.toString(),typeVar.toString(),idVarleft,idVarright);
                            simbolo.setValue(getValue(e.toString()));
                            TablaSimbolos.agregarSimbolo(simbolo);
                            emit(typeVar.toString() + ":" +idVar.toString() + "=" + getValue(e.toString()));
                            RESULT=""+typeVar.toString()+":"+idVar.toString();
                        } catch (Exception ex) {
                            emit("!!!!! ERROR !!!!! - Error in variable declaration with value: " + ex.getMessage() + ". Line: " + idVarleft);
                            semanticErrors = true;
                        }
                    :};

// Declaración de función
//
// La regla `function_declaration` define la declaración de una función, incluyendo su tipo de retorno, nombre y parámetros.
// Se registran los parámetros de la función en la tabla de símbolos y se genera el código necesario para invocar la función, 
// procesando los parámetros pasados durante la llamada.
//
// Generación de código:
// - Se registra la función en la tabla de símbolos junto con su tipo de retorno y sus parámetros.
// - Se emite código para procesar la llamada a la función, incluyendo la carga de los parámetros en memoria.
// - El código de la función es generado después de la declaración del bloque de código.
function_declaration ::= type:typeVar ID:idVar LEFT_PARENTHESIS parameters:p RIGHT_PARENTHESIS LEFT_BRACE 
                        {:
                            try {
                                if (commentTac) emit("// Function " + idVar.toString() + " declaration");
                                Simbolo simbolo = new Simbolo(idVar.toString(),typeVar.toString(),idVarleft,idVarright);
                                simbolo.setFunction(typeVar.toString(), TablaSimbolos.getParametrosEnEspera());
                                TablaSimbolos.limpiarParametrosEnEspera();
                                TablaSimbolos.agregarSimbolo(simbolo);
                                String functionLabel = idVar.toString();
                                emit(functionLabel + ":");
                                String[] parameters = p.toString().split(",");
                                try {
                                    for (String parameter: parameters) {
                                        emit (getValue(parameter) + "=pop");
                                    }
                                } catch (Exception e) {
                                    emit("!!!!! ERROR !!!!! - Error while processing function parameters: " + e.getMessage() + ". Line: " + idVarleft);
                                    semanticErrors = true;
                                }
                            } catch (Exception ex) {
                                emit("!!!!! ERROR !!!!! - Error in function declaration: " + ex.getMessage() + ". Line: " + idVarleft);
                                semanticErrors = true;
                            }
                        :} 
                        code_block RIGHT_BRACE;

// Declaración de parámetros de función
//
// La regla `parameters` define los parámetros de una función, especificando su tipo y nombre.
// Los parámetros se agregan a la tabla de símbolos de manera que la función pueda acceder a ellos durante su ejecución.
//
// Generación de código:
// - Los parámetros se registran en la tabla de símbolos como variables locales dentro de la función.
// - Se emite el código para la declaración de cada parámetro.
parameters ::= type:typeVar ID:idVar {:
                try {
                    Simbolo simbolo = new Simbolo(idVar.toString(),typeVar.toString(),idVarleft,idVarright);
                    TablaSimbolos.agregarParametroEnEspera(simbolo);
                    TablaSimbolos.agregarSimbolo(simbolo);
                    RESULT = typeVar.toString() + ":" + idVar.toString();
                } catch (Exception ex) {
                    emit("!!!!! ERROR !!!!! - Error in parameter declaration: " + ex.getMessage() + ". Line: " + idVarleft);
                    semanticErrors = true;
                }
            :}//Entrada de parametros
                | type:typeVar ID:idVar COMMA parameters:p {:
                try {
                    Simbolo simbolo = new Simbolo(idVar.toString(),typeVar.toString(),idVarleft,idVarright);
                    TablaSimbolos.agregarParametroEnEspera(simbolo);
                    TablaSimbolos.agregarSimbolo(simbolo);
                    RESULT = typeVar.toString() + ":" + idVar.toString() + "," + p.toString();
                } catch (Exception ex) {
                    emit("!!!!! ERROR !!!!! - Error in parameter declaration: " + ex.getMessage() + ". Line: " + idVarleft);
                    semanticErrors = true;
                }
            :}| {:RESULT="";:};

// Llamada a una función
//
// La regla `function_call` se utiliza para invocar una función previamente declarada.
// Se verifica que la función exista en la tabla de símbolos, que sea efectivamente una función, 
// y que el número de argumentos proporcionados coincida con el número de parámetros esperados.
//
// Generación de código:
// - Se emite el código necesario para llamar a la función y gestionar su retorno.
// - Se asegura que los argumentos sean correctos antes de realizar la llamada.
function_call ::= ID:id LEFT_PARENTHESIS arguments:args RIGHT_PARENTHESIS 
                    {: 
                    try {
                        if (commentTac) emit("// Calling function " + id.toString() + " with arguments " + args.toString() + "--------------");
                        Simbolo simbolo = TablaSimbolos.buscar(id.toString());
                        if (simbolo == null) {
                            emit("!!!!! ERROR !!!!! - ID " + id.toString() + " not found. Line: " + idleft);
                            semanticErrors = true;
                        }
                        if (!simbolo.isFunction()) {
                            emit("!!!!! ERROR !!!!! - ID " + id.toString() + " is not a function. Line: " + idleft);
                            semanticErrors = true;
                        }
                        int arguments = args.toString().isEmpty() ? 0 : args.toString().split(",").length;
                        if (arguments != simbolo.getParameters().size()) {
                            emit("!!!!! ERROR !!!!! - Function " + id.toString() + " expects " + simbolo.getParameters().size() + " arguments, but " + args.toString().split(",").length + " were provided. Line: " + idleft);
                            semanticErrors = true;
                        }
                        String temp = newTemp(); 
                        emit("call " + id.toString());
                        emit(temp + "=$ret"); 
                        RESULT = simbolo.returnType+":"+temp; 
                    } catch (Exception ex) {
                        emit("!!!!! ERROR !!!!! - Error in function call: " + ex.getMessage() + ". Line: " + idleft);
                        semanticErrors = true;
                    }
                    :};

// Expresión de retorno
//
// La regla `return` define la declaración de un retorno de valor desde una función.
// El valor de retorno se verifica y se emite el código correspondiente para retornar dicho valor.
//
// Generación de código:
// - Se emite el código para retornar el valor especificado desde la función.
arguments ::= expression:e {:
                try {
                    emit("push " + e.toString());
                    RESULT = e;
                } catch (Exception ex) {
                    emit("!!!!! ERROR !!!!! - Error in arguments: " + ex.getMessage() + ". Line: " + eleft);
                    semanticErrors = true;
                }
            :}
            | expression:e COMMA arguments:a {:
                try {
                    emit("push " + e.toString());
                    RESULT = e.toString() + "," + a.toString();
                } catch (Exception ex) {
                    emit("!!!!! ERROR !!!!! - Error in arguments: " + ex.getMessage() + ". Line: " + eleft);
                    semanticErrors = true;
                }
            :}| {:RESULT = "";:};

// Entrada de datos
//
// La regla `read` representa la entrada de datos por parte del usuario para una variable especificada.
// Se verifica que el identificador sea una variable de tipo `string`, y se genera el código necesario para leer un valor de entrada.
//
// Generación de código:
// - Se lee el valor de entrada del usuario y se almacena en la variable correspondiente.
// - Se emite el código necesario para la operación de entrada.
return ::= RETURN expression:e SEMICOLON {:
                try {
                    emit("return " + getValue(e.toString()));
                } catch (Exception ex) {
                    emit("!!!!! ERROR !!!!! - Error in return statement: " + ex.getMessage());
                    semanticErrors = true;
                }
            :}
            | RETURN SEMICOLON {:
                try {
                    emit("return");
                } catch (Exception ex) {
                    emit("!!!!! ERROR !!!!! - Error in return statement: " + ex.getMessage());
                    semanticErrors = true;
                }
            :};

// Instrucción de impresión
//
// La regla `print` define la instrucción para imprimir el valor de una expresión en la salida estándar.
// Se verifica que el tipo de la expresión sea compatible con los tipos válidos para la impresión (string, int, float), 
// y se genera el código para imprimir el valor.
//
// Generación de código:
// - Se emite el código para imprimir el valor de la expresión especificada.
read ::= INPUT LEFT_PARENTHESIS ID:id RIGHT_PARENTHESIS SEMICOLON 
    {: 
        try {
            if (commentTac) emit("// Read statement");
            Simbolo simbolo = TablaSimbolos.buscar(id.toString());
            if (simbolo == null) {
                emit("!!!!! ERROR !!!!! - ID " + id.toString() + " not found. Line: " + idleft);
                semanticErrors = true;
            }
            String type = simbolo.type;
            if (!type.equals("string")) {
                emit("!!!!! ERROR !!!!! - ID " + id.toString() + " is not a string. Variable destination has to be of value string. Line: " + idleft);
                semanticErrors = true;
            }
            String temp = newTemp(); 
            emit("read " + temp);
            emit(id.toString() + "=" + temp);  
            RESULT = "string:" + id.toString();
        } catch (Exception ex) {
            emit("!!!!! ERROR !!!!! - Error in read statement: " + ex.getMessage() + ". Line: " + idleft);
            semanticErrors = true;
        }
    :};

// Producción: print
//
// La regla print define una declaración de impresión en el lenguaje, donde se evalúa una expresión y se imprime su valor.
//
// Generación de código:
// - La expresión se evalúa y se verifica su tipo para asegurar que sea uno de los tipos permitidos: string, int o float.
// - Si la expresión es válida, se genera un código temporal para su valor y se empuja a la pila para su impresión.
// - Si el tipo no es válido, se genera un error semántico.
print ::= PRINT LEFT_PARENTHESIS expression:e RIGHT_PARENTHESIS SEMICOLON 
    {: 
        try {
            if (commentTac) emit("// Print statement");
            String type = getType(e.toString());
            if (!type.equals("string") && !type.equals("int") && !type.equals("float")) {
                emit("!!!!! ERROR !!!!! - Only string, int and float values are allowed for print. Line: " + eleft);
                semanticErrors = true;
            }
            String temp = newTemp();
            emit(temp + "=" + getValue(e.toString()));
            emit("push " + temp);
            emit("print"); 
        } catch (Exception ex) {
            emit("!!!!! ERROR !!!!! - Error in print statement: " + ex.getMessage() + ". Line: " + eleft);
            semanticErrors = true;
        }
    :};

// Producción: if
//
// La regla if define una estructura condicional que evalúa una expresión booleana y ejecuta un bloque de código si la condición es verdadera, o un bloque alternativo si es falsa.
//
// Generación de código:
// - Se verifica que la expresión tenga tipo booleano, de lo contrario, se genera un error semántico.
// - Se generan etiquetas de salto para manejar el flujo del código dependiendo de si la condición es verdadera o falsa.
// - Si la condición es falsa, se salta al bloque `else`, si está presente, y se ejecuta el bloque correspondiente.
if ::= IF LEFT_PARENTHESIS expression:e RIGHT_PARENTHESIS {:
        try {
            if (commentTac) emit("// If statement ---------------");
            String tipo = getType(e.toString());
            if (!tipo.equals("bool")) {
                emit("!!!!! ERROR !!!!! - Expression in if has to be of type boolean. Line: " + eleft);
                semanticErrors = true;
            }
            String endLabel = newLabel();
            String elseLabel = newLabel();
            stackEndLabels.push(endLabel);
            stackEndLabels.push(elseLabel);
            emit("ifFalse " + getValue(e.toString()) + " goto " + elseLabel);
        } catch (Exception ex) {
            emit("!!!!! ERROR !!!!! - Error in if statement: " + ex.getMessage() + ". Line: " + eleft);
            semanticErrors = true;
        }
    :} block ELSE {:
        try {
            String elseLabel = stackEndLabels.pop();
            String endLabel = stackEndLabels.pop();
            emit("goto " + endLabel);
            emit(elseLabel + ":");
            stackEndLabels.push(endLabel);
        } catch (Exception ex) {
            emit("!!!!! ERROR !!!!! - Error in else statement: " + ex.getMessage() + ". Line: " + eleft);
            semanticErrors = true;
        }
    :} block {:
        try {
            String endLabel = stackEndLabels.pop();
            emit(endLabel + ":");
        } catch (Exception ex) {
            emit("!!!!! ERROR !!!!! - Error in if-else statement: " + ex.getMessage() + ". Line: " + eleft);
            semanticErrors = true;
        }
    :}; 

// Producción: for_initialization
//
// La regla for_initialization define la inicialización de una variable dentro de un bucle `for`, que se realiza con un tipo de dato y una expresión de asignación.
//
// Generación de código:
// - Se reserva espacio en la tabla de símbolos para la variable, se asigna su valor según la expresión dada y se genera el código correspondiente para la asignación.
for_initialization ::= type:typeVar ID:idVar ASSIGNMENT expression:e
                        {:
                        try {
                            Simbolo simbolo = new Simbolo(idVar.toString(),typeVar.toString(),idVarleft,idVarright);
                            TablaSimbolos.agregarSimbolo(simbolo);
                            simbolo.setValue(getValue(e.toString()));
                            emit(typeVar.toString() + ":" + idVar.toString() + "=" + getValue(e.toString()));
                        } catch (Exception ex) {
                            emit("!!!!! ERROR !!!!! - Error in for initialization: " + ex.getMessage() + ". Line: " + idVarleft);
                            semanticErrors = true;
                        }
                    :};

// Producción: for
//
// La regla for define un bucle que itera hasta que una condición booleana especificada sea falsa.
//
// Generación de código:
// - Se verifica que la expresión de la condición tenga tipo booleano, de lo contrario, se genera un error semántico.
// - Se generan etiquetas de salto para controlar el inicio y final del bucle.
// - El cuerpo del bucle se ejecuta mientras la condición sea verdadera. Al final de cada iteración, se evalúa una operación unaria (incremento o decremento) sobre la variable de control del bucle.
for ::= {:if (commentTac) emit("// For loop --------------");:} 
        FOR LEFT_PARENTHESIS for_initialization SEMICOLON expression:e SEMICOLON unary_operation:u RIGHT_PARENTHESIS {:
        try {
            String tipo = getType(e.toString());
            if (!tipo.equals("bool")) {
                emit("!!!!! ERROR !!!!! - 2nd expression in for in for has to be of type boolean. Line: " + eleft);
                semanticErrors = true;
            }
            String endLabel = newLabel();
            String startLabel = newLabel();
            stackStartLabels.push(startLabel);
            stackEndLabels.push(endLabel);
            emit(startLabel + ":");
            emit("ifFalse " + getValue(e.toString()) + " goto " + endLabel);
        } catch (Exception ex) {
            emit("!!!!! ERROR !!!!! - Error in for loop: " + ex.getMessage() + ". Line: " + eleft);
            semanticErrors = true;
        }
    :} block {:
        try {
            String startLabel = stackStartLabels.pop();
            String endLabel = stackEndLabels.pop();
            String[] partsUnaryOperation = u.toString().split(":");
            String id = partsUnaryOperation[2];
            String operation = partsUnaryOperation[3];
            String temp1 = newTemp();
            emit(temp1 + "=1");
            String temp2 = newTemp();
            if (operation.equals("+")) 
                emit(temp2 + "=" + id + "+" + temp1);
            else 
                emit(temp2 + "=" + id + "-" + temp1);
            emit(id + "=" + temp2);
            emit("goto " + startLabel);
            emit(endLabel + ":");
        } catch (Exception ex) {
            emit("!!!!! ERROR !!!!! - Error in for loop block: " + ex.getMessage() + ". Line: " + eleft);
            semanticErrors = true;
        }
    :};

// Producción: while
//
// La regla while define un bucle que continúa ejecutándose mientras se cumpla una condición booleana.
//
// Generación de código:
// - Se verifica que la expresión de la condición tenga tipo booleano. Si no es así, se genera un error semántico.
// - Se generan etiquetas de salto para gestionar el inicio y el fin del bucle. 
// - Al final de cada iteración, el flujo vuelve a la condición para evaluar si el bucle debe continuar ejecutándose.
while ::= WHILE LEFT_PARENTHESIS expression:e RIGHT_PARENTHESIS
            {: 
            try {
                if (commentTac) emit("// While loop ---------------");
                Simbolo expression = TablaSimbolos.buscar(getValue(e.toString()));
                if (expression == null) {
                    emit("!!!!! ERROR !!!!! - Expression not found. Line: " + eleft);
                    semanticErrors = true;
                } else if (!expression.getType().equals("bool")) {
                    emit("!!!!! ERROR !!!!! - Expression has to be of type boolean. Line: " + eleft);
                    semanticErrors = true;
                }
                String startLabel = newLabel();
                String endLabel = newLabel();
                emit(startLabel + ":");
                emit("ifFalse " + getValue(e.toString()) + " goto " + endLabel);
                stackStartLabels.push(startLabel);
                stackEndLabels.push(endLabel);
            } catch (Exception ex) {
                emit("!!!!! ERROR !!!!! - Error in while loop: " + ex.getMessage() + ". Line: " + eleft);
                semanticErrors = true;
            }
            :} 
            block 
            {: 
            try {
                String endLabel = stackEndLabels.pop();
                String startLabel = stackStartLabels.pop();
                emit("goto " + startLabel);
                emit(endLabel + ":");
            } catch (Exception ex) {
                emit("!!!!! ERROR !!!!! - Error in while loop block: " + ex.getMessage() + ". Line: " + eleft);
                semanticErrors = true;
            }
            :};

// Producción: case1
//
// La regla case1 define un caso dentro de una estructura `switch`, donde se compara una expresión con la expresión del `switch`.
//
// Generación de código:
// - Se verifica que el tipo de la expresión del caso coincida con el tipo de la expresión del `switch`.
// - Se genera un código que compara ambas expresiones y, si no coinciden, salta al siguiente caso o a la etiqueta correspondiente.
// - En caso de que coincidan, se ejecuta el bloque de código asociado al caso.
case1 ::= CASE expression:e COLON {:
    try {
        String label = getCurrentSwitchLabel();
        String expressionType = getType(e.toString());
        String switchExpression = getCurrentSwitchExpression();
        if (!expressionType.equals(getType(switchExpression)))
            emit("!!!!! ERROR !!!!! - Case expression has to be of the same type as the switch expression. Line: " + eleft);
        String temp = newTemp();
        setCurrentSwitchLabel(newLabel());
        emit(label + ":");
        emit("ifFalse " + getValue(e.toString()) + "==" + getValue(getCurrentSwitchExpression()) + " goto " + currentSwitchLabel);
    } catch (Exception ex) {
        emit("!!!!! ERROR !!!!! - Error in case statement: " + ex.getMessage() + ". Line: " + eleft);
    }
:} code_block BREAK {: 
    try {
        String endLabel = stackEndLabels.peek();
        emit("goto " + endLabel);
    } catch (Exception ex) {
        emit("!!!!! ERROR !!!!! - Error in case break: " + ex.getMessage());
    }
:} SEMICOLON {:RESULT = e.toString();:};

single_case ::= case1:c {:RESULT = c.toString();:};

cases ::= single_case cases
        | single_case;

switch_aux ::= SWITCH LEFT_PARENTHESIS expression:e RIGHT_PARENTHESIS 
            LEFT_BRACE 
            {: 
                try {
                    if (commentTac) emit("// Switch statement -----------------");
                    TablaSimbolos.abrirScope(); 
                    String endLabel = newLabel(); 
                    stackEndLabels.push(endLabel);
                    setCurrentSwitchExpression(e.toString()); 
                    setCurrentSwitchLabel(newLabel()); 
                } catch (Exception ex) {
                    emit("!!!!! ERROR !!!!! - Error in switch statement: " + ex.getMessage() + ". Line: " + eleft);
                    semanticErrors = true;
                }
            :} 
            cases;

// Producción: switch
//
// La regla switch define una estructura de control que permite ejecutar uno de varios bloques de código basados en la comparación de una expresión con valores especificados en casos.
//
// Generación de código:
// - Se verifica que todos los casos tengan el mismo tipo que la expresión del `switch`.
// - Se gestionan las etiquetas de salto para controlar el flujo del programa según el caso que coincida con el valor de la expresión.
// - Si no hay coincidencias, se ejecuta el bloque `default`, si está presente.
switch ::= switch_aux:a RIGHT_BRACE 
            {: 
                try {
                    TablaSimbolos.cerrarScope(); 
                    String endLabel = stackEndLabels.pop(); 
                    emit(currentSwitchLabel + ":"); 
                    emit(endLabel + ":"); 
                } catch (Exception ex) {
                    emit("!!!!! ERROR !!!!! - Error in switch statement: " + ex.getMessage() + ". Line: " + aleft);
                    semanticErrors = true;
                }
            :}
            | switch_aux:a DEFAULT COLON {:emit(currentSwitchLabel + ":");:} code_block RIGHT_BRACE 
            {: 
                try {
                    TablaSimbolos.cerrarScope(); 
                    String endLabel = stackEndLabels.pop(); 
                    emit(endLabel + ":"); 
                } catch (Exception ex) {
                    emit("!!!!! ERROR !!!!! - Error in switch default case: " + ex.getMessage() + ". Line: " + aleft);
                    semanticErrors = true;
                }
            :};

array_declaration_aux ::=
type:t 
{:
    try {
        if (!t.toString().equals("int") && !t.toString().equals("char")) {
            emit("!!!!! ERROR !!!!! - Only int and char arrays are allowed. Line: " + tleft);
            semanticErrors = true;
        }
    } catch (Exception ex) {
        emit("!!!!! ERROR !!!!! - Error in array declaration: " + ex.getMessage() + ". Line: " + tleft);
        semanticErrors = true;
    }
:}
LEFT_BRACKET expression:s {:
    try {
        String size = s.toString();
        if (!getType(size).equals("int")) {
            emit("!!!!! ERROR !!!!! - Array size has to be an integer. Line: " + sleft);
            semanticErrors = true;
        }
    } catch (Exception ex) {
        emit("!!!!! ERROR !!!!! - Error in array size: " + ex.getMessage() + ". Line: " + sleft);
        semanticErrors = true;
    }
:} RIGHT_BRACKET ID:id {:
    try {
        Simbolo simboloBuscar = TablaSimbolos.buscar(id.toString());
        if (simboloBuscar != null) {
            emit("!!!!! ERROR !!!!! - ID " + id.toString() + " already exists. Line: " + idleft);
            semanticErrors = true;
        }
        Simbolo simbolo = new Simbolo(id.toString(), t.toString(), idleft, idright);
        simbolo.setArray();
        TablaSimbolos.agregarSimbolo(simbolo);
        RESULT = t.toString() + ":" + id.toString();
        emit("" + t.toString() + ":" + id.toString() + "=newArray " + getValue(s.toString()));
    } catch (Exception ex) {
        emit("!!!!! ERROR !!!!! - Error in array declaration: " + ex.getMessage() + ". Line: " + idleft);
        semanticErrors = true;
    }
:};

// Producción: array_declaration_aux
//
// La regla array_declaration_aux define la declaración de un arreglo con un tipo específico (int o char) y un tamaño especificado por una expresión.
//
// Generación de código:
// - Se verifica que el tipo del arreglo sea int o char, de lo contrario se genera un error semántico.
// - Se valida que el tamaño del arreglo sea un valor entero válido y que la declaración cumpla con las restricciones de tipos.
array_declaration ::= array_declaration_aux:t ASSIGNMENT LEFT_BRACE array_values:v {:
    try {
        String[] values = v.toString().split(",");
        int i = 0;
        String[] infoArray = t.toString().split(":");
        Simbolo simbolo = TablaSimbolos.buscar(infoArray[1]);  
        simbolo.setArraySize(values.length);
        for (String value: values) {
            if (!getType(value).equals(getType(t.toString()))) {
                emit("!!!!! ERROR !!!!! - Array values have to be of the same type as the array. Line: " + tleft);
                semanticErrors = true;
            }
            emit(infoArray[1] + "[" + i + "]=" + getValue(value));
            i++;
        }
    } catch (Exception ex) {
        emit("!!!!! ERROR !!!!! - Error in array declaration with values: " + ex.getMessage() + ". Line: " + tleft);
        semanticErrors = true;
    }
:} RIGHT_BRACE SEMICOLON 
    | array_declaration_aux SEMICOLON;

array_values ::=  expression:e {:RESULT=e;:} | expression:e COMMA array_values:values {:RESULT=e.toString()+","+values.toString();:};

array_access ::= ID:id LEFT_BRACKET expression:e {:
    try {
        String type = getType(e.toString());
        if (!type.equals("int")) {
            emit("!!!!! ERROR !!!!! - Array access index has to be an integer. Line: " + eleft);
            semanticErrors = true;
        }
        Simbolo simbolo = TablaSimbolos.buscar(id.toString());
        if (simbolo == null) {
            emit("!!!!! ERROR !!!!! - ID " + id.toString() + " array not found. Line: " + idleft);
            semanticErrors = true;
        } else if (!simbolo.isArray()) {
            emit("!!!!! ERROR !!!!! - ID " + id.toString() + " is not an array. Line: " + idleft);
            semanticErrors = true;
        }
        String temp = newTemp();
        emit(temp + "=" + id.toString() + "[" + getValue(e.toString()) + "]");
        RESULT = simbolo.type + ":" + temp + ":" + id.toString() + "[" + getValue(e.toString()) + "]";
    } catch (Exception ex) {
        emit("!!!!! ERROR !!!!! - Error in array access: " + ex.getMessage() + ". Line: " + idleft);
        semanticErrors = true;
    }
:} RIGHT_BRACKET;
array_position_assignment ::= array_access:a ASSIGNMENT expression:e {:
    try {
        if (!getType(a.toString()).equals(getType(e.toString()))) {
            emit("!!!!! ERROR !!!!! - Incompatible types for array position assignment. Line: " + aleft);
            semanticErrors = true;
        }
        emit(a.toString().split(":")[2] + "=" + getValue(e.toString()));
        RESULT = e.toString();
    } catch (Exception ex) {
        emit("!!!!! ERROR !!!!! - Error in array position assignment: " + ex.getMessage() + ". Line: " + aleft);
        semanticErrors = true;
    }
:};

main ::= MAIN LEFT_PARENTHESIS RIGHT_PARENTHESIS block;

program ::= program_aux;

program_aux ::= function_declaration program_aux
            | main {:
                try {
                    Proyecto1.tac = tac;
                } catch (Exception ex) {
                    emit("!!!!! ERROR !!!!! - Error in program: " + ex.getMessage());
                }
            :};